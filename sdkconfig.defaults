# ESP32-S3 目标芯片
CONFIG_IDF_TARGET="esp32s3"

# 日志等级
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL_VERBOSE=n

# 开启 PSRAM（ESP32-S3-BOX-3 为 8MB 八线 PSRAM；自拼板若为四线请改 CONFIG_SPIRAM_MODE_QUAD）
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# 关闭 BT 以节省内存（本项目仅用 WiFi）
CONFIG_BT_ENABLED=n
