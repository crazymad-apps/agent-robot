# ESP32-S3-DevKitC-1 v1.1 / ESP32-S3-WROOM-1-N8R8
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"

# N8R8 uses 8 MB octal PSRAM. GPIO35/36/37 are therefore reserved internally.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MEMTEST=y

CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# The DevKit's native USB Serial/JTAG port is the interactive console.  A
# secondary USB console is output-only in ESP-IDF and cannot receive commands.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Keep the one-shot microphone WAV in a dedicated 256 KiB data partition.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# S2 local wake baseline: official Chinese WakeNet9 model ("你好小智").
CONFIG_MODEL_IN_FLASH=y
CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=y
